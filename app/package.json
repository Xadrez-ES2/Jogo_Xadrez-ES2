{
  "name": "jogo-xadrez",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:interface:unit": "vitest run --config vitest.interface.unit.config.ts",
    "test:interface:integration": "vitest run --config vitest.interface.integration.config.ts",
    "coverage:interface:integration": "vitest run --config vitest.interface.integration.config.ts --coverage",
    "test:interface:system": "vitest run --config vitest.interface.system.config.ts",
    "coverage:interface:system": "vitest run --config vitest.interface.system.config.ts --coverage",
    "evidence:interface": "node scripts/collect-interface-evidence.mjs",
    "coverage:interface:unit": "vitest run --config vitest.interface.unit.config.ts --coverage",
    "coverage": "vitest run --coverage --coverage.include=src/ai/**/*.ts",
    "test:engine": "vitest run --config vitest.engine.config.ts --configLoader runner",
    "test:engine:unit": "npm run test:engine -- --exclude **/*.integration.test.*",
    "test:engine:coverage": "npm run test:engine -- --coverage",
    "test:engine:coverage:unit": "npm run test:engine:unit -- --coverage",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "29.1.1",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.1.0"
  }
}
